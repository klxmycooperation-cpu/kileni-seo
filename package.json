{
  "name": "kileni-seo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env.local worker/index.ts",
    "build": "next build --webpack && pnpm worker:build",
    "start": "node scripts/start.mjs",
    "worker": "tsx worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-worker/worker.js",
    "worker:start": "node dist-worker/worker.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "generate:briefs": "node scripts/generate-briefs.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.4",
    "@next/env": "^16.2.12",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "chrome-launcher": "^1.2.1",
    "docx": "^9.5.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.3.1",
    "framer-motion": "^12.43.0",
    "ipaddr.js": "^2.2.0",
    "lighthouse": "^13.4.1",
    "next": "^16.2.12",
    "nodemailer": "^9.0.1",
    "p-limit": "^7.2.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.66.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.3",
    "tldts": "^7.0.17",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "type": "module"
}
