# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3000/admin
DATABASE_PATH=./data/kileni.sqlite
PRIVATE_UPLOADS_PATH=./data/uploads
BACKUP_PATH=./backups
IP_HASH_SALT=replace-with-at-least-32-random-characters
# Required for forms on Vercel. Signs the public-only audit restore envelope.
AUDIT_RESTORE_SECRET=replace-with-at-least-32-random-characters
PRELAUNCH_MODE=false
FORMS_ENABLED=true
# Set only on a disposable preview that must never inherit production integrations.
KILENI_ISOLATED_PREVIEW=false

# Administrator (generate hash: pnpm tsx scripts/hash-password.ts "password")
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_HOURS=8
ADMIN_PDF_FONT_PATH=
ADMIN_PDF_FONT_BOLD_PATH=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Approved public contacts. E-mail and Telegram are intentionally not public contact settings.
PUBLIC_PHONE="+7 000 000-00-00"
PUBLIC_MAX="+7 000 000-00-00"
PUBLIC_MAX_URL=

# Durable Vercel database (recommended: Turso Free; create the database before filling these values)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Fill only in the protected runtime environment from the approved company card.
LEGAL_NAME=
LEGAL_SHORT_NAME=
LEGAL_ADDRESS=
# Optional: leave empty until the inbox has been tested and formally approved for legal requests.
LEGAL_EMAIL=
LEGAL_EMAIL_VERIFIED=false
LEGAL_INN=
LEGAL_OGRNIP=
LEGAL_REGISTRATION_AUTHORITY=
LEGAL_REGISTRATION_DATE=
LEGAL_POLICY_VERSION=2026-08-23
LEGAL_POLICY_URL=/privacy
LEGAL_CONSENT_URL=/consent

# Required as a pair while the public audit is enabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional explicit English price currency. Set both values or EN shows "Individual estimate".
# Rate is units of the target currency per 1 RUB (example only; choose and approve your own commercial rate).
NEXT_PUBLIC_EN_PRICE_CURRENCY=
NEXT_PUBLIC_EN_PRICE_RATE=

# Audit limits
AUDIT_TIMEOUT_MS=420000
# Повторный домен использует сохранённый результат ровно 7 дней (серверный фиксированный срок).
AUDIT_RESULT_RETENTION_DAYS=90
WORKER_POLL_MS=1500
AUDIT_USER_AGENT="KILENI-SEO-Audit/1.0 (public technical check)"
LIGHTHOUSE_ENABLED=true
LIGHTHOUSE_CHROME_PATH=
LIGHTHOUSE_NO_SANDBOX=false
